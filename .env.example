# ============================================================
#  双模型校验知识库 Agent — 环境变量配置模板
#
#  使用方式：复制为 .env 并修改
#    cp .env.example .env
# ============================================================

# ---- 应用配置 ----
APP_NAME=双模型校验知识库 Agent
APP_VERSION=0.5.4
DEBUG=false

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000

# ---- 模型A：主生成模型（provider=deepseek 时使用） ----
MODEL_A_API_KEY=sk_9router
MODEL_A_BASE_URL=http://127.0.0.1:20128/v1
MODEL_A_NAME=ds/deepseek-chat

# ---- 模型B：质量校验模型（provider=deepseek 时使用） ----
MODEL_B_API_KEY=sk_9router
MODEL_B_BASE_URL=http://127.0.0.1:20128/v1
MODEL_B_NAME=ds/deepseek-chat
# 模型B 评审输出 token 上限（给足余量，避免评审 JSON 被截断为空）
LLM_REVIEW_MAX_TOKENS=4096

# ---- 模型A/B 后端 provider（可切换） ----
# provider 二选一：deepseek（本地代理，默认）/ ollama
MODEL_PROVIDER=deepseek
# provider=ollama 时使用（需先 ollama pull 对应模型）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_A=qwen2.5:7b
OLLAMA_MODEL_B=qwen2.5:7b

# ---- 嵌入模型（稠密检索） ----
# provider 二选一：sentence-transformers（本地，推荐默认） / ollama
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# provider=ollama 时使用（本地 Ollama 的 OpenAI 兼容地址）
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_DEVICE=cpu

# HuggingFace 模型下载镜像（国内访问官方 huggingface.co 慢/不通，设镜像加速）
HF_ENDPOINT=https://hf-mirror.com

# ---- Qdrant 向量数据库（稠密检索） ----
# 无需 Docker：QDRANT_URL 留空，数据落到本地 QDRANT_LOCAL_PATH 目录
QDRANT_URL=
QDRANT_LOCAL_PATH=./qdrant_data
QDRANT_COLLECTION=knowledge_base

# ---- 检索模式 ----
USE_DENSE_RETRIEVAL=true

# ---- RAG 参数 ----
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ---- 知识库路径 ----
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# ---- 安全检查 ----
SAFETY_ENABLED=true
SAFETY_SENSITIVE_WORDS=

# ---- Langfuse 可观测性（可选，Day 14） ----
# 密钥在 Langfuse 面板 Project Settings → API Keys 生成（pk-lf-... / sk-lf-...）
# LANGFUSE_BASE_URL 按注册时选择的数据区域填：日本地区 = https://jp.cloud.langfuse.com
# （EU=https://cloud.langfuse.com，US=https://us.cloud.langfuse.com）
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com

# ---- 日志 ----
LOG_LEVEL=INFO
