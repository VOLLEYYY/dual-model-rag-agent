# ============================================================
#  Docker 构建忽略（docker build 时排除，避免密钥/缓存/数据进镜像）
# ============================================================

# ---- 环境与密钥 ----
.env
.env.example
*.key
*.pem

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 数据（运行时通过 volume 挂载，不进镜像） ----
data/
qdrant_data/
ollama_data/

# ---- Git / IDE ----
.git/
.gitignore
.idea/
.vscode/
*.swp

# ---- 报告与日志 ----
*.log
